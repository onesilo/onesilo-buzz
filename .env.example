# --- Buzz workspace ---
# WebSocket URL of the workspace relay (the single source of truth in Buzz).
BUZZ_RELAY_URL=wss://relay.your-workspace.buzz.xyz

# Comma-separated channel ids to listen in. Empty = all channels the agent
# has been added to / can see.
BUZZ_CHANNEL_IDS=

# --- Agent identity ---
# The agent's @handle in the workspace (used for mention matching).
AGENT_HANDLE=silo
# Hex-encoded Nostr secret key. Leave unset to generate a fresh keypair on
# boot (the key is printed once so you can pin it).
AGENT_SECRET_KEY=

# --- Silo memory backend ---
# "local" (JSON file, zero infrastructure) or "backend" (recap-silo-backend).
SILO_MODE=local
SILO_LOCAL_PATH=.silo/memories.json

# Required when SILO_MODE=backend:
SILO_API_URL=https://api.onesilo.com
SILO_ID=
SILO_API_TOKEN=
