# --- Buzz workspace ---
# WebSocket URL of the workspace relay (the single source of truth in Buzz).
# Leave unset and `onesilo-buzz run` asks on first run, saving the answer here.
BUZZ_RELAY_URL=wss://relay.your-workspace.buzz.xyz

# Comma-separated channel ids to listen in. Empty = discover them: the agent
# reads the relay's member lists on start (and every 30s) and subscribes to
# each channel it belongs to. Set this to pin it to a subset instead.
#
# It has to name each channel: Buzz keeps channel-scoped and global
# subscriptions separate for live delivery, so a subscription that doesn't
# name a channel receives history and then nothing at all.
BUZZ_CHANNEL_IDS=

# --- Memory mode ---
# Where this workspace's conversation is distilled and stored. One knob for
# the common case; SILO_MODE/DISTILL_MODE below still work and still win.
#
#   cloud   transcripts go to your silo, distilled there with full turn
#           context and enriched (entities, topics, relationships).
#           @mentions get a composed, grounded answer. Raw conversation
#           leaves this machine.
#   hybrid  a local onesilo-node distills; only the resulting statements
#           reach your silo, where they are enriched. Raw conversation
#           never leaves. Recommended.
#   local   distilled and stored entirely on your node. Nothing is sent to
#           One Silo. No enrichment, and @mentions return a ranked list of
#           memories rather than a composed answer.
#
# `onesilo-buzz run` asks on first run when none of these are set.
# MEMORY_MODE=hybrid

# --- Agent identity ---
# The agent's @handle in the workspace (used for mention matching and as the
# connection name in the One Silo dashboard: "Buzz Agent (@OneSilo)").
AGENT_HANDLE=OneSilo
# Avatar published in the agent's profile (NIP-01 `picture`). Defaults to the
# One Silo mark; set empty to publish no avatar.
# AGENT_PICTURE_URL=https://onesilo.com/apple-touch-icon.png
# Hex-encoded Nostr secret key. Leave unset to generate a fresh keypair on
# boot — the new secret is written to a 0600 file (AGENT_SECRET_KEY_PATH,
# default .silo/agent.key), never printed, so it can't leak into logs. That
# file is loaded automatically on the next start, so the identity is stable
# without any manual step. Set AGENT_SECRET_KEY to override it explicitly.
AGENT_SECRET_KEY=
# AGENT_SECRET_KEY_PATH=.silo/agent.key

# --- One Silo memory ---
# "mcp" (default): the agent is a standard MCP client of the One Silo control
#   plane — OAuth pairing via `npm run connect`, memory via the existing
#   silo_* tool surface, connection visible in the dashboard.
# "relay": One Silo through a gateway onesilo-node's /v1/cloud/mcp relay — the
#   node holds the only cloud credential; the agent authenticates with the
#   node key and never pairs itself.
# "node": memory served by a local onesilo-node's memory API (SQLite, hybrid
#   recall). With DISTILL_MODE=node, the fully on-machine stack.
# "local": JSON-file store, zero infrastructure (demo/dev).
SILO_MODE=mcp

# mcp mode:
SILO_SERVER_URL=https://connect.onesilo.com
# Default memory bucket. "default" targets the connection's auto-provisioned
# cloud silo; set a silo id to use a specific (e.g. shared) silo instead —
# the silo must be granted to this agent's connection in the One Silo dashboard.
SILO_ID=default
# Optional per-channel memory buckets: comma-separated channel=silo_id pairs.
# Channels not listed use SILO_ID. Point multiple agents (or channels) at the
# same silo id to share memory.
#   SILO_CHANNEL_MAP=eng=8f2c...-uuid,support=8f2c...-uuid,exec=default
SILO_CHANNEL_MAP=
SILO_TOKEN_PATH=.silo/oauth.json
SILO_OAUTH_CALLBACK_PORT=8765

# local mode:
SILO_LOCAL_PATH=.silo/memories.json

# --- Private distillation (onesilo-node) ---
# Where transcript distillation happens:
# "cloud" (default): conversation segments go to your silo raw and One
#   Silo's server-side pipeline distills them with context.
# "node": a onesilo-node on this machine (https://github.com/onesilo/onesilo-node)
#   distills segments with its local model FIRST — raw conversation never
#   leaves the machine; only distilled memory statements sync to your silo.
#   If the node is down, captures buffer and retry; the agent never falls
#   back to sending raw transcripts.
DISTILL_MODE=cloud
# onesilo-node endpoints (defaults match `onesilo-node setup` on the same machine).
# These MUST be loopback: the admin token and node key are high-value local
# secrets and are refused if the URL points off this machine. To reach a
# remote node, set NODE_ALLOW_REMOTE=1 AND use https:// (never plaintext).
# Admin API: distillation (compute/generate) and status.
NODE_URL=http://127.0.0.1:8766
# Leave unset to read ~/.onesilo-node/admin.token (written by `onesilo-node setup`).
NODE_ADMIN_TOKEN=
# LAN API: the memory API (SILO_MODE=node) and cloud relay (SILO_MODE=relay).
NODE_LAN_URL=http://127.0.0.1:8765
# Leave unset to read ~/.onesilo-node/node.key, or fetch via the admin API.
NODE_KEY=
# Set to 1 only to reach a node on another host — requires https:// URLs above.
# NODE_ALLOW_REMOTE=

# --- Conversation capture ---
# The agent buffers turns per channel and sends whole conversational
# episodes (speaker-attributed transcripts) to the silo for distillation
# with context. Tune the window here.
# Flush after this many buffered turns:
CAPTURE_WINDOW_TURNS=12
# Turns carried into the next segment as context (episodes spanning two
# flushes keep their thread):
CAPTURE_OVERLAP_TURNS=2
# Quiet time (seconds) that closes an episode and flushes it:
CAPTURE_IDLE_FLUSH_SECONDS=600
